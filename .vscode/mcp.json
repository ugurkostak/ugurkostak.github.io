{
  "servers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["@playwright/mcp@latest"],
      "env": {
        "PLAYWRIGHT_BROWSERS_PATH": "0"
      }
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
				"--registry",
				"https://registry.npmjs.org",
				"chrome-devtools-mcp@1.1.1"
			],
			"gallery": "https://api.mcp.github.com",
			"version": "1.1.1"
    }

    
  }
}
